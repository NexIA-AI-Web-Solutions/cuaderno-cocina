# Ejemplo de contrato: Codex debe conectar y validar estas variables en la implementación.
# Ningún secreto real se incluye. No basta copiar este archivo para arrancar una app todavía inexistente.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ORIGIN=http://localhost:3000
APP_EDITION=esencial
DATA_DIR=./var
BETTER_AUTH_SECRET=GENERAR_DE_FORMA_SEGURA_AL_INICIALIZAR
# En producción, ORIGIN es HTTPS y la configuración privada vive fuera del repositorio.
