#   1.2.11-r4:
#     - CVE-2018-25032
#   0:
#     - CVE-2023-45853
#     - CVE-2023-6992

build() {
	# we trade size for a little more speed.
	export CFLAGS="$CFLAGS -O2"
	CHOST="$CHOST" ./configure \
		--prefix=/usr \
		--shared \
		--disable-crcvx
	make
}

check() {
	make check
}

package() {
	make install DESTDIR="$pkgdir"
}

